# Project 9 is a localhost-only research and paper-simulation application.
# These are shell environment variables; Node does not automatically load .env files.
PORT=4179
# PROJECT9_DATA_FILE=/absolute/path/to/paper.json

# Optional read-only historical market-data provider. Keep the key on your device,
# never in Git or a browser bundle. An unavailable/invalid key fails closed.
# MASSIVE_API_KEY=

# Without a provider key, import a permitted v2 JSON dataset using:
# npm run import:market -- /absolute/path/to/market-dataset-v2.json
# The validated cache is .data/market-cache/SYMBOL.json (never commit .data).

# Optional paid AI commentary. It never places orders or determines research rules.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
